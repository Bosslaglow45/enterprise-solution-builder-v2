{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "NetworkingCatalogSchema",
  "type": "object",
  "required": [
    "id",
    "pillar",
    "vendor",
    "models"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "pillar": {
      "type": "string",
      "const": "networking"
    },
    "vendor": {
      "type": "string",
      "enum": [
        "Dell",
        "Arista",
        "Generic"
      ]
    },
    "driverVersion": {
      "type": "string"
    },
    "models": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "modelName",
          "role",
          "switchingCapacityTbps",
          "ports"
        ],
        "properties": {
          "modelName": {
            "type": "string",
            "example": "Arista 7050SX3-48YC8 / Dell S5248F-ON"
          },
          "role": {
            "type": "string",
            "enum": [
              "ToR_Leaf",
              "Spine",
              "Management",
              "Edge_Interconnect"
            ]
          },
          "formFactor": {
            "type": "string",
            "enum": [
              "1U",
              "2U"
            ]
          },
          "switchingCapacityTbps": {
            "type": "number"
          },
          "ports": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "count",
                "connectorType",
                "speedGbps"
              ],
              "properties": {
                "count": {
                  "type": "integer"
                },
                "connectorType": {
                  "type": "string",
                  "enum": [
                    "SFP+",
                    "SFP28",
                    "QSFP+",
                    "QSFP28",
                    "QSFP-DD",
                    "OSFP",
                    "RJ45"
                  ]
                },
                "speedGbps": {
                  "type": "integer",
                  "enum": [
                    1,
                    10,
                    25,
                    40,
                    50,
                    100,
                    200,
                    400
                  ]
                },
                "breakoutCapable": {
                  "type": "boolean"
                },
                "portRole": {
                  "type": "string",
                  "enum": [
                    "Downlink",
                    "Uplink",
                    "Management",
                    "Stacking"
                  ],
                  "description": "Used to derive oversubscription"
                },
                "breakoutModes": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "description": "e.g. 4x25G, 4x10G, 2x50G"
                  },
                  "description": "Supported breakout configurations (e.g. QSFP28 100G -> 4x25G SFP28)"
                }
              }
            }
          },
          "cableSupport": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "Passive_DAC",
                "Active_AOC",
                "Optical_Transceiver"
              ]
            }
          },
          "supportedFeatures": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "MLAG",
                "EVPN-VXLAN",
                "BGP",
                "RoCEv2",
                "PTP"
              ]
            }
          },
          "oversubscriptionRatio": {
            "type": "number",
            "description": "Declared downlink:uplink ratio as N (N:1). 1 = non-blocking. Derivable from ports[].portRole when absent",
            "minimum": 0
          },
          "nonBlocking": {
            "type": "boolean"
          },
          "forwardingRateMpps": {
            "type": "number",
            "description": "Forwarding rate (Mpps)",
            "minimum": 0
          },
          "transceiverSupport": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "formFactor",
                "speedGbps",
                "media"
              ],
              "properties": {
                "formFactor": {
                  "type": "string",
                  "enum": [
                    "SFP+",
                    "SFP28",
                    "QSFP+",
                    "QSFP28",
                    "QSFP-DD",
                    "OSFP"
                  ]
                },
                "speedGbps": {
                  "type": "integer",
                  "enum": [
                    1,
                    10,
                    25,
                    40,
                    50,
                    100,
                    200,
                    400
                  ]
                },
                "media": {
                  "type": "string",
                  "enum": [
                    "Passive_DAC",
                    "Active_DAC",
                    "AOC",
                    "SR",
                    "LR",
                    "ER",
                    "BASE-T"
                  ]
                },
                "maxReachMeters": {
                  "type": "number",
                  "description": "Maximum reach (m)",
                  "exclusiveMinimum": 0
                },
                "breakoutTo": {
                  "type": "string",
                  "description": "Far-end layout for breakout cables, e.g. 4xSFP28"
                }
              }
            },
            "description": "Transceiver / DAC / AOC form factors accepted per speed class"
          }
        }
      }
    }
  }
}
