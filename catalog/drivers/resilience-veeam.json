{
  "$schema": "../resilience.schema.json",
  "id": "veeam-data-platform",
  "pillar": "resilience",
  "vendor": "Veeam",
  "driverVersion": "1.0.0",
  "editions": [
    {
      "editionName": "Veeam Data Platform Advanced / Premium",
      "licensingModel": "VUL_Per_Instance",
      "supportedWorkloads": [
        "VMware",
        "Hyper-V",
        "AHV",
        "Physical_Server",
        "NAS_File",
        "M365",
        "Kubernetes",
        "Cloud_Native"
      ],
      "immutabilitySupport": {
        "hardenedRepositoryLinux": true,
        "s3ObjectLock": true,
        "retentionLock": true
      },
      "sizingFormulas": {
        "recommendedProxyCpuPerConcurrentTask": 1,
        "recommendedProxyRamGbPerConcurrentTask": 2,
        "dedupeCompressionEstimateRatio": 2.8
      }
    }
  ]
}